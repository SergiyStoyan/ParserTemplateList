<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<ForceDesignerDPIUnaware>true</ForceDesignerDPIUnaware>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<!-- Optional: Keeps legacy default font (Microsoft Sans Serif 8.25pt) instead of Segoe UI 9pt -->
		<!--ApplicationDefaultFont>Microsoft Sans Serif, 8.25pt</ApplicationDefaultFont-->

		<Version>6.0.0</Version>
		<Authors>Sergiy Stoyan</Authors>
		<Company>CliverSoft</Company>
		<Copyright>Sergiy Stoyan</Copyright>
		<RootNamespace>Cliver.ParserTemplateList</RootNamespace>
		<Platforms>AnyCPU;x64</Platforms>

	</PropertyGroup>

	<ItemGroup>
	  <None Remove=".gitattributes" />
	  <None Remove=".gitignore" />
	  <None Remove="LICENSE" />
	</ItemGroup>


	<ItemGroup>
		<PackageReference Include="CliverRoutines" Version="7.0.0" />
		<PackageReference Include="CliverWinRoutines" Version="3.0.1.594" />
	</ItemGroup>


	<ItemGroup>
	  <ProjectReference Include="..\PdfDocumentParser\PdfDocumentParser.csproj" />
	</ItemGroup>


</Project>
